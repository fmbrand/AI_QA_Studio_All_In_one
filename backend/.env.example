# Backend settings. Copy to backend/.env for local development. Never commit the real .env.

ENVIRONMENT=development
# Local dev database from `python scripts/devdb.py start` (trust auth, no password).
DATABASE_URL=postgresql+psycopg://postgres@127.0.0.1:5434/ai_qa_studio
# Tests use this database and wipe it on every run.
TEST_DATABASE_URL=postgresql+psycopg://postgres@127.0.0.1:5434/ai_qa_studio_test

# Required in production: a random string of 32+ characters, e.g. `python -c "import secrets; print(secrets.token_urlsafe(48))"`
JWT_SECRET=
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=14
# Set to true when the site is served over HTTPS.
COOKIE_SECURE=false

CORS_ORIGINS=http://localhost:3000

STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage
MAX_UPLOAD_MB=25
