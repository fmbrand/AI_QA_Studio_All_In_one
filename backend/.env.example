# Backend settings. Copy to backend/.env for local development. Never commit the real .env.

ENVIRONMENT=development
# Local dev database from `python scripts/devdb.py start` (trust auth, no password).
DATABASE_URL=postgresql+psycopg://postgres@127.0.0.1:5434/ai_qa_studio
# Tests use this database and wipe it on every run.
TEST_DATABASE_URL=postgresql+psycopg://postgres@127.0.0.1:5434/ai_qa_studio_test

# Required in production: a random string of 32+ characters, e.g. `python -c "import secrets; print(secrets.token_urlsafe(48))"`
JWT_SECRET=
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=14
# Set to true when the site is served over HTTPS.
COOKIE_SECURE=false

CORS_ORIGINS=http://localhost:3000

STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage
MAX_UPLOAD_MB=25

# --- AI: language model (requirement extraction) ---
# none | anthropic | openai | ollama. With "none" AI features are off and the app says so.
LLM_PROVIDER=none
# Anthropic (Claude). Leave the key empty to use the SDK's own lookup (ANTHROPIC_API_KEY env or `ant auth login`).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max (thinking depth and cost)
ANTHROPIC_EFFORT=high
# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=
# Ollama or any OpenAI-compatible local server
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=
LLM_MAX_OUTPUT_TOKENS=16000

# --- AI: embeddings for semantic search (runs locally, no key) ---
EMBEDDING_PROVIDER=fastembed
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# Where the model is downloaded on first use (default: system temp directory)
EMBEDDING_CACHE_DIR=

# --- Context engine ---
# Path to tesseract if it is not on PATH; leave empty to auto-detect. Without it, scanned pages are skipped.
TESSERACT_CMD=
OCR_LANGUAGES=eng
CHUNK_SIZE_CHARS=1200
CHUNK_OVERLAP_CHARS=200
EXTRACTION_WINDOW_CHARS=24000
