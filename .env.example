# Settings for `docker compose up`. Copy to .env (never commit .env).

ENVIRONMENT=production
# Required: a random string of 32+ characters.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
POSTGRES_PASSWORD=qa

# Where the browser reaches the API, and which web origin the API trusts.
PUBLIC_API_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000
# true when served over HTTPS (required for real deployments).
COOKIE_SECURE=false

MAX_UPLOAD_MB=25

# AI (see backend/.env.example for every option). "none" keeps AI features off.
LLM_PROVIDER=none
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
